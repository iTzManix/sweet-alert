# URL del backend FastAPI (docs/api.md). En dispositivo físico usar la IP de la
# máquina en la red local en vez de localhost, ej. http://192.168.1.50:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Project Settings > API en el dashboard de Supabase (backend/.env.example
# tiene la misma SUPABASE_URL). El anon key es público por diseño, seguro
# para el cliente — nunca el service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://jfgoulzoicabmsxnoxym.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
